{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ue-shed.dev/contracts/cameras/authoring/v1/visibility-preset.schema.json",
	"type": "object",
	"properties": {
		"version": {
			"type": "number",
			"enum": [1]
		},
		"id": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
		},
		"name": {
			"type": "string",
			"minLength": 1
		},
		"projectName": {
			"type": "string",
			"minLength": 1
		},
		"mapPath": {
			"type": "string",
			"pattern": "^\\/Game\\/"
		},
		"actors": {
			"type": "object",
			"properties": {
				"hide": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"locator": {
								"anyOf": [
									{
										"type": "object",
										"properties": {
											"kind": {
												"type": "string",
												"enum": ["actor_path"]
											},
											"actorPath": {
												"type": "string",
												"pattern": "^\\/Game\\/",
												"maxLength": 4096
											}
										},
										"required": ["kind", "actorPath"],
										"additionalProperties": false
									},
									{
										"type": "object",
										"properties": {
											"kind": {
												"type": "string",
												"enum": ["actor_guid"]
											},
											"actorGuid": {
												"type": "string"
											},
											"lastKnownActorPath": {
												"type": "string",
												"maxLength": 4096
											}
										},
										"required": ["kind", "actorGuid", "lastKnownActorPath"],
										"additionalProperties": false
									}
								]
							},
							"label": {
								"type": "string",
								"maxLength": 256
							}
						},
						"required": ["locator", "label"],
						"additionalProperties": false
					},
					"maxItems": 256
				},
				"protect": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"locator": {
								"anyOf": [
									{
										"type": "object",
										"properties": {
											"kind": {
												"type": "string",
												"enum": ["actor_path"]
											},
											"actorPath": {
												"type": "string",
												"pattern": "^\\/Game\\/",
												"maxLength": 4096
											}
										},
										"required": ["kind", "actorPath"],
										"additionalProperties": false
									},
									{
										"type": "object",
										"properties": {
											"kind": {
												"type": "string",
												"enum": ["actor_guid"]
											},
											"actorGuid": {
												"type": "string"
											},
											"lastKnownActorPath": {
												"type": "string",
												"maxLength": 4096
											}
										},
										"required": ["kind", "actorGuid", "lastKnownActorPath"],
										"additionalProperties": false
									}
								]
							},
							"label": {
								"type": "string",
								"maxLength": 256
							}
						},
						"required": ["locator", "label"],
						"additionalProperties": false
					},
					"maxItems": 256
				}
			},
			"required": ["hide", "protect"],
			"additionalProperties": false
		}
	},
	"required": ["version", "id", "name", "projectName", "mapPath", "actors"],
	"additionalProperties": false,
	"$defs": {}
}
